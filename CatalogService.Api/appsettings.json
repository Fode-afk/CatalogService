{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "RabbitMQ": {
    "VirtualHost": "/"
  },
  "SoftDeletedProductsCleanup": {
    "CronExpression": "0 */6 * * *",
    "RetentionPeriod": 30,
    "BatchSize": 500
  }
}